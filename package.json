{
  "name": "hol-mcp-server-poc",
  "version": "0.1.0",
  "description": "No-stubs HOL MCP Server POC",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.6.0",
  "scripts": {
    "dev:stdio": "MCP_TRANSPORT=stdio tsx src/index.ts",
    "dev:http": "MCP_TRANSPORT=http tsx src/index.ts",
    "dev:http:compat": "FEATURE_LEGACY_SSE=1 MCP_TRANSPORT=http tsx src/index.ts",
    "build": "tsup --config tsup.config.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check:no-stubs": "tsx scripts/tool-suite/run-tool-suite.ts",
    "live:runs": "tsx scripts/e2e/live-runs.ts",
    "smoke:http": "tsx scripts/e2e/streamable-http-smoke.ts",
    "smoke:stdio": "tsx scripts/e2e/stdio-smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hashgraphonline/standards-sdk": "^0.1.164",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "bottleneck": "^2.19.5",
    "dotenv": "^17.3.1",
    "express": "4",
    "pino": "^10.3.1",
    "undici": "^7.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "@vitest/coverage-v8": "^4.0.18",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
